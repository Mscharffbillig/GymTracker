# Analytics and feedback endpoint URLs.
#
# REQUIRED — both must be complete HTTPS URLs pointing to the Cloudflare Worker.
# EXPO_PUBLIC_* variables are inlined by Metro at bundle time (no runtime file read).
#
# For local development you may leave these blank; analytics will queue events
# locally without transmitting and feedback will show a mock response in __DEV__.
# In production they must be set as EAS environment variables (see below).
#
# Required EAS environment (production):
#   eas env:create --name EXPO_PUBLIC_ANALYTICS_URL --value "https://YOUR-WORKER/v1/analytics/events" \
#     --environment production --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_FEEDBACK_URL  --value "https://YOUR-WORKER/v1/feedback" \
#     --environment production --visibility plaintext
#
# Verify with:
#   eas env:list --environment production
#
# OTA updates MUST be published with --environment production so these variables
# are baked into the bundle:
#   eas update --channel production --environment production --message "description"

EXPO_PUBLIC_ANALYTICS_URL=
EXPO_PUBLIC_FEEDBACK_URL=
